    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "puppeteer-core": "25.17.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
