# Copy to .env.local (git-ignored). Never commit real values.
#
# RULE: anything named NEXT_PUBLIC_* is sent to every browser. Only put values
# there that are safe to be public. Everything else stays on the server.

# ---------------------------------------------------------------- Supabase: parent accounts
# Both empty = parent accounts are OFF: the demo works, /sign-in says "not available yet", /api/brain
# lets in only holders of BRAIN_TESTER_CODE. Both set = parents can sign in (magic link or email + password).
# The URL and the publishable key are public by design (they only work because every table has row-level
# security, supabase/migrations). Use the PUBLISHABLE key ("sb_publishable_..." or the legacy anon key).
# A secret / service_role key here is rejected on purpose (it would bypass row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The public address of the site (https). Used for the link in sign-in emails and for the canonical URL.
# Empty = the address the request came to (fine for localhost). Must also be listed under Supabase > Authentication > URL Configuration.
NEXT_PUBLIC_SITE_URL=
# NOTE: this app has no use for the Supabase secret / service_role key and must never be given one.

# ---------------------------------------------------------------- Claude brain (Stage B)
# SERVER ONLY. Used by the /api/brain route; never sent to the browser.
ANTHROPIC_API_KEY=
# Models are constants in src/lib/brain/server/config.ts (Haiku 5.5 default, Sonnet 5.5 for hard turns); there is no model env var.
# Kill switch: 1 / true / yes stops every model call at once (lessons fall back to the script).
BRAIN_DISABLED=
# SERVER ONLY. Private-test passcode. A request carrying it in the x-gleeful-tester header may use the AI without signing in; testers enter it once on /tester (kept in
# that browser tab only). Use 16+ random characters. Everyone else needs a signed-in parent with consent on file.
BRAIN_TESTER_CODE=
# Build-time opt-in for the Claude brain: set to "model". Not a secret. Empty = scripted lesson.
NEXT_PUBLIC_BRAIN=

# ---------------------------------------------------------------- Limits
# Max minutes per lesson (the client ends the session; the server must enforce it too in Stage B).
NEXT_PUBLIC_MAX_SESSION_MINUTES=15
