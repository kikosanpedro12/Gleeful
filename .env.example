# Copy to .env.local (git-ignored). Never commit real values.
#
# RULE: anything named NEXT_PUBLIC_* is sent to every browser. Only put values
# there that are safe to be public. Everything else stays on the server.

# ---------------------------------------------------------------- Supabase (Stage E)
# Public by design. Safe ONLY because every table has row-level security (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses row-level security. Never import it in client code. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Claude brain (Stage B)
# SERVER ONLY. Used by the /api/brain route; never sent to the browser.
ANTHROPIC_API_KEY=
# Models are constants in src/lib/brain/server/config.ts (Haiku 5.5 default, Sonnet 5.5 for hard turns); there is no model env var.
# Kill switch: 1 / true / yes stops every model call at once (lessons fall back to the script).
BRAIN_DISABLED=
# SERVER ONLY. Private-test passcode. When set, /api/brain refuses (403) any request without it in the
# x-gleeful-tester header; testers enter it once on /tester (kept in that browser tab only). Use 16+ random
# characters. A stopgap so a real key can sit behind the public URL during a private test, not a replacement for sign-in.
BRAIN_TESTER_CODE=
# Build-time opt-in for the Claude brain: set to "model". Not a secret. Empty = scripted lesson.
NEXT_PUBLIC_BRAIN=

# ---------------------------------------------------------------- Limits
# Max minutes per lesson (the client ends the session; the server must enforce it too in Stage B).
NEXT_PUBLIC_MAX_SESSION_MINUTES=15
