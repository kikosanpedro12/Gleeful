# Copy to .env.local (git-ignored). Never commit real values.
#
# RULE: anything named NEXT_PUBLIC_* is sent to every browser. Only put values
# there that are safe to be public. Everything else stays on the server.

# ---------------------------------------------------------------- Supabase: parent accounts
# Both empty = parent accounts are OFF: the demo works, /sign-in says "not available yet", /api/brain
# lets in only holders of BRAIN_TESTER_CODE. Both set = parents can sign in (magic link or email + password).
# The URL and the publishable key are public by design (they only work because every table has row-level
# security, supabase/migrations). Use the PUBLISHABLE key ("sb_publishable_..." or the legacy anon key).
# A secret / service_role key here is rejected on purpose (it would bypass row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The public address of the site (https). Used for the link in sign-in emails and for the canonical URL.
# Empty = the address the request came to (fine for localhost). Must also be listed under Supabase > Authentication > URL Configuration.
NEXT_PUBLIC_SITE_URL=
# NOTE: this app has no use for the Supabase secret / service_role key and must never be given one.

# ---------------------------------------------------------------- Claude brain (Stage B)
# SERVER ONLY. Used by the /api/brain route; never sent to the browser.
ANTHROPIC_API_KEY=
# Models are constants in src/lib/brain/server/config.ts (Haiku 5.5 default, Sonnet 5.5 for hard turns); there is no model env var.
# Kill switch: 1 / true / yes stops every model call at once (lessons fall back to the script).
BRAIN_DISABLED=
# SERVER ONLY. Private-test passcode. A request carrying it in the x-gleeful-tester header may use the AI without signing in; testers enter it once on /tester (kept in
# that browser tab only). Use 16+ random characters. Everyone else needs a signed-in parent with consent on file.
BRAIN_TESTER_CODE=
# SERVER ONLY. The anonymous "Ask the teacher" box on the home page (/api/taste) uses the SAME ANTHROPIC_API_KEY, Haiku only, no tools.
# TASTE_DISABLED=
# Signs the free-tries cookie (any long random string). Optional: falls back to a key derived from ANTHROPIC_API_KEY.
TASTE_COOKIE_SECRET=1 switches just that box off (BRAIN_DISABLED=1 switches it off too). Without a key the page shows a labelled Preview.
# Daily ceilings, in-memory brakes per server instance (the Console spend limit is the real ceiling). Blank = defaults; values outside the range are ignored.
TASTE_DISABLED=
# Questions per client address per day (default 9, 1 to 60).
TASTE_DAILY_TURNS_PER_IP=
# Questions for the whole site per day (default 600, 1 to 5000).
TASTE_DAILY_TURNS_GLOBAL=
# Build-time opt-in for the Claude brain: set to "model". Not a secret. Empty = scripted lesson.
NEXT_PUBLIC_BRAIN=

# ---------------------------------------------------------------- Limits
# Max minutes per lesson (the client ends the session; the server must enforce it too in Stage B).
NEXT_PUBLIC_MAX_SESSION_MINUTES=15

# ---------------------------------------------------------------- Text-to-speech (server-only, never NEXT_PUBLIC_)
# Deepgram Aura-2 key for /api/tts. Needs BRAIN_TESTER_CODE too (same passcode gate).
DEEPGRAM_API_KEY=
# Set to 1 to switch the voice route off.
TTS_DISABLED=
# Characters spoken per day for the whole site (default 60000, hard cap 300000).
TTS_DAILY_CHARS=

# ElevenLabs key for /api/voice (Text to Speech only, credit cap set, 90-day expiry). Same passcode gate and TTS_DISABLED switch.
ELEVENLABS_API_KEY=
# Characters spoken per day for the whole site (default 30000, hard cap 100000).
ELEVEN_DAILY_CHARS=
# Optional: eleven_v4_turbo (default), eleven_v4 or eleven_flash_v2_5.
ELEVEN_MODEL=
# Optional: 20-character voice ids for Leo and Mia. Unset = stand-in premade voices.
ELEVEN_VOICE_LEO=
ELEVEN_VOICE_MIA=
# Characters of tutor speech per tester per day (default 6000, hard cap 20000). Each invite code is its own tester.
ELEVEN_TESTER_DAILY_CHARS=
# Public voice taste. OFF unless "on". Founder-gated: set the credit cap on the ElevenLabs key FIRST (it is the only real ceiling).
ELEVEN_PUBLIC=
ELEVEN_ANON_IP_CHARS=
ELEVEN_PARENT_CHARS=
ELEVEN_ANON_POOL_CHARS=
# Landing taste voice (founder decision 21 Nov). ON whenever ELEVENLABS_API_KEY is set; "off" switches it off.
ELEVEN_LANDING=
# All landing visitors together, characters per day PER WARM SERVER INSTANCE (default and hard cap 5000; can only be lowered). A brake, not a ceiling: the credit cap on the ElevenLabs key is the ceiling. Per-address bucket = ELEVEN_ANON_IP_CHARS.
ELEVEN_LANDING_DAILY_CHARS=

# Per-tester invite codes for the brain and the voice: name:code pairs, comma separated. Name a-z 0-9 _ -, code 16+
# random characters, at most 50. A BRAIN_TESTER_CODE under 16 characters switches the invites off too. Remove an entry (and redeploy) to revoke that tester. BRAIN_TESTER_CODE still works.
TESTER_INVITES=

# ---------------------------------------------------------------- Admin page (/admin), SERVER ONLY, never NEXT_PUBLIC_
# Comma list of sign-in emails and/or Supabase user ids (UUIDs) allowed to open /admin (read-only). Empty = nobody.
# Anything else (domains, wildcards, typos) is ignored. Everyone not listed gets a plain 404.
ADMIN_EMAILS=
