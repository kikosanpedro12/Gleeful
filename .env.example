# Copy to .env.local. Never commit real values. Everything is server-only
# except names starting NEXT_PUBLIC_ (sent to the browser; never put secrets there).

# Standard OpenAI API key. Used only by /api/realtime/token to mint short-lived
# client secrets. Without it the app runs in clearly-labelled DEMO mode.
OPENAI_API_KEY=

# Realtime model. gpt-realtime-2.1 confirmed in official docs 2026-11-12.
# gpt-realtime-2.1-mini is the cheaper candidate to A/B (see docs/COSTS.md).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Voice for Leo. Verify the available voice list in the OpenAI docs/dashboard.
OPENAI_REALTIME_VOICE_LEO=cedar

# Optional shared passcode. If set, the token route refuses requests without it
# (protects your API spend on a private test deployment). REQUIRED when deployed:
# in production the token route refuses to work without it.
APP_ACCESS_CODE=

# Max live sessions minted per server process per hour (spend guard).
MAX_SESSIONS_PER_HOUR=12

# Hard cap on one live session, minutes (client disconnects at the cap).
NEXT_PUBLIC_MAX_SESSION_MINUTES=15

# Phase 3+ (not used yet)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
